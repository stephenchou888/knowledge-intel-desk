# ==============================================================================
# Server-Side LLM Provider API Keys
# Copy this file to .env and fill in only the provider keys you need.
# Never commit real API keys to version control.
# ==============================================================================

# OpenAI (https://api.openai.com/v1)
OPENAI_API_KEY=

# Google Gemini (https://generativelanguage.googleapis.com)
GEMINI_API_KEY=

# Anthropic Claude (https://api.anthropic.com/v1)
ANTHROPIC_API_KEY=

# DeepSeek (https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=

# 智谱 GLM (https://open.bigmodel.cn/api/paas/v4)
GLM_API_KEY=

# 月之暗面 Kimi (https://api.moonshot.cn/v1)
KIMI_API_KEY=

# 腾讯混元 Tencent Hunyuan (https://api.hunyuan.cloud.tencent.com/v1)
TENCENT_API_KEY=

# JEV 决策模型接口
JEV_API_KEY=

# 其它自定义兼容接口（如 OpenRouter / 硅基流动 / One-API / 中转站）
CUSTOM_LLM_API_KEY=

# Optional: Server port for Web deployment (default: 3000)
# PORT=3000

