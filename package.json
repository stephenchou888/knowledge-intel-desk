{
  "name": "knowledge-intel-desk",
  "private": true,
  "version": "1.0.0",
  "description": "知识库信息核查 — 多格式解析、自定义多模型初筛与 11 列 CSV 导出桌面端与网页端",
  "author": "Knowledge Intel Desk",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "build:desktop-assets": "npm run build && npm run build:server",
    "desktop:dev": "npm run build:desktop-assets && electron .",
    "desktop:build": "npm run build:desktop-assets && electron-builder --config electron-builder.yml --publish never",
    "desktop:build:win": "npm run build:desktop-assets && electron-builder --config electron-builder.yml --win --publish never",
    "desktop:build:mac": "npm run build:desktop-assets && electron-builder --config electron-builder.yml --mac --publish never",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
